# Generated LiveKit service credentials (do not commit .env.local)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Direct voice-model providers
CEREBRAS_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TAVILY_API_KEY=

# LiveKit outbound SIP trunk ID returned by `lk sip outbound create`
SIP_OUTBOUND_TRUNK_ID=

# The local FastAPI service that supplies per-call context and receives results.
# For the Daytona-backend setup, point this to the Mac relay instead:
# CALL_BACKEND_URL=http://127.0.0.1:8010
CALL_BACKEND_URL=http://127.0.0.1:8000
