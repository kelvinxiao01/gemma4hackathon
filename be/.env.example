# Generated LiveKit service credentials (do not commit .env.local). They are
# needed in normal local-backend mode and by the Mac-side Daytona relay, but
# not by the backend running inside a Daytona sandbox.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The normal mode connects this backend directly to LiveKit Cloud. For a
# Daytona-hosted backend use `daytona-relay`; the Mac-side relay then owns the
# LiveKit credentials and polls this backend over its signed Preview URL.
CALL_DISPATCH_MODE=livekit

# Required in `daytona-relay` mode on both machines. Generate a unique random
# value with at least 24 characters. Never commit or share it.
CALL_RELAY_SECRET=

# Required only by the Daytona backend. A caller must send this separate bearer
# token to POST /calls or POST a facility demo call through the signed Preview
# URL. The Mac-side relay does not need it.
CALL_LAUNCH_SECRET=

# Used only by the Mac-side `scripts/daytona_relay.py`, never by the Daytona
# backend. Set it to the HTTPS URL from `daytona preview-url ...`.
DAYTONA_BACKEND_URL=

# Required only for POST /facility-searches. It is intentionally read by the
# backend rather than sent through the browser or voice worker.
TAVILY_API_KEY=

# Required only for POST /facility-searches/{search_id}/demo-calls. This
# endpoint never dials the discovered facility; use the verified demo number.
DEMO_OUTBOUND_PHONE_NUMBER=

# Leave empty until the teammate-owned payer-criteria SQLite database and its
# schema land. The outbound call path falls back to restricted Tavily search.
PAYER_CRITERIA_DB_PATH=
