# Copy these values into be/.env.local inside the Daytona sandbox.
# Do not commit the resulting .env.local.

# The backend holds call context in memory while a Mac-side relay executes the
# LiveKit API locally, since this sandbox cannot currently reach LiveKit Cloud.
CALL_DISPATCH_MODE=daytona-relay
CALL_RELAY_SECRET=
CALL_LAUNCH_SECRET=

# Normal backend settings
TAVILY_API_KEY=
DEMO_OUTBOUND_PHONE_NUMBER=
PAYER_CRITERIA_DB_PATH=

# Do not put a DAYTONA_API_KEY or LiveKit credentials in this sandbox file.
# The relay on the Mac has the local LIVEKIT_URL/LIVEKIT_API_KEY/
# LIVEKIT_API_SECRET values and the same CALL_RELAY_SECRET.
